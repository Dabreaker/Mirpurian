# Local use only: copy this file to .env and fill it in.
# On Vercel, set these in Project > Settings > Environment Variables.

# You choose this one (admin login password)
ADMIN_PASSWORD=change-me

# Added automatically when you connect a Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Added automatically when you connect Upstash Redis to the project
KV_REST_API_URL=
KV_REST_API_TOKEN=
