# Required. On Vercel this is added automatically when you connect a PUBLIC Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Optional: switches on comments, reactions and view counts (free Upstash Redis from the Vercel Marketplace).
# Also added automatically when you connect it to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: how many minutes the post list is cached (default 30). Lower = new posts show sooner,
# but uses more of the free Blob operations.
CACHE_MINUTES=30
